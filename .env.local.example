# Copy this file to .env.local and fill in the values.
#
# LogLead runs fully in "demo mode" without any keys — the Studio will return
# deterministic mock content so you can test the entire flow. Add a real Claude
# API key to get genuine, profile-personalized generation.

# Claude API key (https://console.anthropic.com/). Optional — leave empty for demo mode.
ANTHROPIC_API_KEY=

# IA Visibility — per-provider keys. All optional: each missing key makes that
# LLM run in demo mode (deterministic simulated answer) instead of a real call.
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=

# ----- Leads & analyse de site ---------------------------------------------
# Firecrawl (https://firecrawl.dev) — scrape propre en markdown pour l'analyse
# de site (onboarding, ton de voix). Sans clé, l'app retombe sur un fetch HTML
# brut (fragile).
FIRECRAWL_API_KEY=
# FullEnrich — waterfall email + téléphone (enrichissement lead). Branché.
FULLENRICH_API_KEY=

# ----- LinkedIn (OAuth officiel) -------------------------------------------
# Publication de posts + analytics officiels + profil de l'utilisateur connecté.
# NB : impressions/analytics avancés et DMs nécessitent une validation partenaire
# LinkedIn (Community Management API) — non garantis sans approbation.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://app.loglead.io/auth/callback/linkedin

# ----- Apify (scraping LinkedIn public) ------------------------------------
# Enrichissement de profils, posts concurrents (Market Intelligence), signaux.
# ⚠️ Le scraping LinkedIn viole les CGU LinkedIn (risque de ban) et beaucoup
# d'actors requièrent un cookie de session LinkedIn.
APIFY_API_TOKEN=

# ----- Supabase (database) -------------------------------------------------
# From Supabase → Project Settings → API. The service_role key is SECRET and
# server-only — never expose it to the browser. Required in production (Vercel);
# without it the app falls back to the local JSON store (dev only).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ----- LinkedIn ------------------------------------------------------------
# Integration not built yet — placeholder for when we wire it up.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Secret used to sign session cookies. Any long random string.
# A dev default is used if this is empty, but set your own for anything real.
# In production, set this to a strong random value.
SESSION_SECRET=

# Emails transactionnels (Resend) — sans clé, les emails sont écrits dans
# ./data/outbox/*.html (outbox de dev) au lieu d'être envoyés.
RESEND_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vercel Cron — protège /api/cron/* en production.
CRON_SECRET=

# ----- Stripe (credit top-ups) ---------------------------------------------
# Leave empty to run credit purchases in DEMO mode (credits added instantly,
# no real charge). Add live keys to enable real Stripe Checkout + webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
